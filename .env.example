# ─── ASTPMS Environment Configuration ────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — only .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_URL=http://localhost/project/internship%20project
APP_ENV=development

# SMTP Mail (Gmail Example)
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Search "App Passwords" → Generate for "Mail" → copy 16-char password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=your_gmail@gmail.com
MAIL_PASS=your_16_char_app_password
MAIL_FROM_NAME=ASTPMS T&P Portal
MAIL_FROM_ADDR=your_gmail@gmail.com

# Alternative: Mailtrap (for local testing - emails go to your inbox on mailtrap.io)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_ENCRYPTION=tls
# MAIL_USER=your_mailtrap_user
# MAIL_PASS=your_mailtrap_pass
